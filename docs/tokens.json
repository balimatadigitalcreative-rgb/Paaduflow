{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Paadu Flow design tokens — sumber kebenaran tunggal. tokens.css dihasilkan dari file ini. JANGAN edit tokens.css secara manual.",

  "indigo": {
    "$type": "color",
    "$description": "Ramp brand. Diturunkan dari jangkar 600. CATATAN: jangkar saat ini adalah perkiraan dan harus diganti dengan hex resmi.",
    "50":  { "$value": "#F0EFFC" },
    "100": { "$value": "#E0DEFA" },
    "200": { "$value": "#C4C0F4" },
    "300": { "$value": "#A29CEA" },
    "400": { "$value": "#7E76DC" },
    "500": { "$value": "#605AC9" },
    "600": { "$value": "#3A34B5", "$description": "Jangkar brand" },
    "700": { "$value": "#302B96" },
    "800": { "$value": "#282476" },
    "900": { "$value": "#221F5E" },
    "950": { "$value": "#14123A" }
  },

  "neutral": {
    "$type": "color",
    "$description": "Ramp terpenting — membawa 90% piksel aplikasi. Tidak pernah dapat di-override tenant.",
    "50":  { "$value": "#F8F9FB" },
    "100": { "$value": "#F1F2F6" },
    "200": { "$value": "#E3E5EC" },
    "300": { "$value": "#CBCEDA" },
    "400": { "$value": "#9BA0B3" },
    "450": { "$value": "#8A90A3", "$description": "Setengah langkah. Ada karena 400 hanya 2,60:1 terhadap putih, di bawah ambang WCAG 1.4.11 untuk batas komponen." },
    "500": { "$value": "#6F7588" },
    "600": { "$value": "#565C6E" },
    "700": { "$value": "#434857" },
    "800": { "$value": "#2E323D" },
    "900": { "$value": "#1C1F27" },
    "950": { "$value": "#101319" }
  },

  "success": {
    "$type": "color",
    "50": { "$value": "#E9F7EF" }, "100": { "$value": "#CFEFDF" }, "200": { "$value": "#A3E0C3" },
    "300": { "$value": "#6CCBA0" }, "400": { "$value": "#38B07E" }, "500": { "$value": "#1E9166" },
    "600": { "$value": "#157552" }, "700": { "$value": "#115C42" }, "800": { "$value": "#0E4735" },
    "900": { "$value": "#0B3628" }, "950": { "$value": "#06211A" }
  },

  "warning": {
    "$type": "color",
    "50": { "$value": "#FEF5E7" }, "100": { "$value": "#FCE8C4" }, "200": { "$value": "#F8D28C" },
    "300": { "$value": "#F2B44E" }, "400": { "$value": "#E29616" }, "500": { "$value": "#C07C0C" },
    "600": { "$value": "#9C640A" }, "700": { "$value": "#7C4F0A" }, "800": { "$value": "#623F0B" },
    "900": { "$value": "#4C310A" }, "950": { "$value": "#2E1D05" }
  },

  "danger": {
    "$type": "color",
    "50": { "$value": "#FDECEC" }, "100": { "$value": "#FBD5D5" }, "200": { "$value": "#F6ADAD" },
    "300": { "$value": "#EE7E7E" }, "400": { "$value": "#E15252" }, "500": { "$value": "#CC3434" },
    "600": { "$value": "#A82929" }, "700": { "$value": "#8A2222" }, "800": { "$value": "#6E1D1D" },
    "900": { "$value": "#571818" }, "950": { "$value": "#350E0E" }
  },

  "info": {
    "$type": "color",
    "$description": "Hue ±208°, sengaja dijauhkan dari indigo brand (±244°) agar pesan informasi tidak tertukar dengan elemen brand.",
    "50": { "$value": "#E8F3FC" }, "100": { "$value": "#CDE5F9" }, "200": { "$value": "#9FCDF3" },
    "300": { "$value": "#6BB0E9" }, "400": { "$value": "#3B90DA" }, "500": { "$value": "#1F72BD" },
    "600": { "$value": "#175B9A" }, "700": { "$value": "#14497B" }, "800": { "$value": "#123A61" },
    "900": { "$value": "#102F4C" }, "950": { "$value": "#081C2E" }
  },

  "dataviz": {
    "$type": "color",
    "$description": "Okabe–Ito dengan indigo brand sebagai kategori pertama. WAJIB dipasangkan dengan pembeda kedua (pola, marker, atau label langsung) — WCAG 1.4.1.",
    "1": { "$value": "#3A34B5" }, "2": { "$value": "#E69F00" }, "3": { "$value": "#56B4E9" },
    "4": { "$value": "#009E73" }, "5": { "$value": "#CC79A7" }, "6": { "$value": "#0072B2" },
    "7": { "$value": "#D55E00" }, "8": { "$value": "#6F7588" }
  },

  "space": {
    "$type": "dimension",
    "$description": "Basis 4px. Angka pada nama adalah pengali basis. Nilai di luar skala ini adalah bug.",
    "0":   { "$value": "0px" },
    "px":  { "$value": "1px" },
    "0-5": { "$value": "2px" },
    "1":   { "$value": "4px" },
    "2":   { "$value": "8px" },
    "3":   { "$value": "12px" },
    "4":   { "$value": "16px", "$description": "Padding default" },
    "5":   { "$value": "20px" },
    "6":   { "$value": "24px" },
    "8":   { "$value": "32px" },
    "10":  { "$value": "40px" },
    "12":  { "$value": "48px" },
    "16":  { "$value": "64px" },
    "20":  { "$value": "80px" },
    "24":  { "$value": "96px" }
  },

  "size": {
    "$type": "dimension",
    "control-sm":        { "$value": "28px" },
    "control-md":        { "$value": "36px", "$description": "Default" },
    "control-lg":        { "$value": "44px" },
    "row-comfortable":   { "$value": "44px" },
    "row-compact":       { "$value": "32px" },
    "sidebar":           { "$value": "240px" },
    "sidebar-collapsed": { "$value": "56px" },
    "touch-min":         { "$value": "44px", "$description": "Minimum mutlak target sentuh. Tidak dapat dikurangi." },
    "container-form":    { "$value": "640px" },
    "container-narrow":  { "$value": "480px" }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm":   { "$value": "4px" },
    "md":   { "$value": "6px", "$description": "Kontrol: input, tombol, select" },
    "lg":   { "$value": "8px" },
    "xl":   { "$value": "12px", "$description": "Kartu, modal" },
    "full": { "$value": "9999px" }
  },

  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": "0.5px", "$description": "Hanya untuk layar retina. Di layar 1x dibulatkan tidak konsisten." },
    "default":  { "$value": "1px" },
    "focus":    { "$value": "2px" }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["IBM Plex Sans", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"] },
      "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600, "$description": "Hanya untuk display dan angka metrik. Bold 700 tidak dipakai di antarmuka." }
    },
    "size": {
      "$type": "dimension",
      "display":   { "$value": "40px" },
      "heading-1": { "$value": "30px" },
      "heading-2": { "$value": "24px" },
      "heading-3": { "$value": "20px" },
      "heading-4": { "$value": "16px" },
      "body-lg":   { "$value": "16px" },
      "body":      { "$value": "14px", "$description": "Default seluruh antarmuka aplikasi" },
      "body-sm":   { "$value": "13px" },
      "caption":   { "$value": "12px" },
      "overline":  { "$value": "11px", "$description": "Batas minimum mutlak. Tidak ada teks di bawah ini." },
      "code":      { "$value": "13px" }
    },
    "line-height": {
      "$type": "dimension",
      "display":   { "$value": "44px" },
      "heading-1": { "$value": "36px" },
      "heading-2": { "$value": "30px" },
      "heading-3": { "$value": "26px" },
      "heading-4": { "$value": "22px" },
      "body-lg":   { "$value": "24px" },
      "body":      { "$value": "20px" },
      "body-compact": { "$value": "18px" },
      "body-sm":   { "$value": "18px" },
      "caption":   { "$value": "16px" },
      "overline":  { "$value": "16px" },
      "code":      { "$value": "20px" }
    },
    "tracking": {
      "display":   { "$value": "-0.02em" },
      "heading-1": { "$value": "-0.015em" },
      "heading-2": { "$value": "-0.01em" },
      "heading-3": { "$value": "-0.01em" },
      "heading-4": { "$value": "-0.005em" },
      "body":      { "$value": "0" },
      "caption":   { "$value": "0.005em" },
      "overline":  { "$value": "0.08em" }
    }
  },

  "z": {
    "$type": "number",
    "$description": "Dilarang menulis nilai z-index literal di komponen mana pun.",
    "base":     { "$value": 0 },
    "raised":   { "$value": 10 },
    "sticky":   { "$value": 100 },
    "nav":      { "$value": 200 },
    "dropdown": { "$value": 1000 },
    "backdrop": { "$value": 1200 },
    "modal":    { "$value": 1300 },
    "popover":  { "$value": 1400 },
    "toast":    { "$value": 1500 },
    "tooltip":  { "$value": 1600, "$description": "Selalu paling atas — dapat muncul di atas elemen mana pun termasuk modal." }
  },

  "duration": {
    "$type": "duration",
    "instant":    { "$value": "0ms" },
    "fast":       { "$value": "100ms" },
    "normal":     { "$value": "160ms", "$description": "Default" },
    "slow":       { "$value": "240ms" },
    "deliberate": { "$value": "320ms", "$description": "Batas maksimum produk. Tidak ada animasi melebihi ini." }
  },

  "ease": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "enter":    { "$value": [0, 0, 0, 1] },
    "exit":     { "$value": [0.3, 0, 1, 1], "$description": "Keluar selalu lebih cepat daripada masuk." },
    "spring":   { "$value": [0.2, 0.8, 0.2, 1] }
  },

  "breakpoint": {
    "$type": "dimension",
    "sm":  { "$value": "640px" },
    "md":  { "$value": "768px" },
    "lg":  { "$value": "1024px" },
    "xl":  { "$value": "1280px", "$description": "Target utama aplikasi. Business OS adalah produk desktop-first." },
    "2xl": { "$value": "1536px" }
  },

  "opacity": {
    "$type": "number",
    "$description": "Tidak pernah dipakai pada teks. Teks disabled memakai token warna, bukan opacity.",
    "disabled":     { "$value": 0.4 },
    "scrim-light":  { "$value": 0.45 },
    "scrim-dark":   { "$value": 0.6 },
    "hover-wash":   { "$value": 0.06 },
    "loading":      { "$value": 0.6 }
  },

  "semantic": {
    "$description": "Lapis 2. Ini yang dibaca komponen. Setiap token punya nilai light dan dark.",
    "light": {
      "$type": "color",
      "bg-canvas":         { "$value": "{neutral.50}" },
      "bg-surface":        { "$value": "#FFFFFF" },
      "bg-surface-raised": { "$value": "#FFFFFF" },
      "bg-surface-sunken": { "$value": "{neutral.100}" },
      "bg-accent-subtle":  { "$value": "{indigo.50}" },
      "text-primary":      { "$value": "{neutral.900}" },
      "text-secondary":    { "$value": "{neutral.600}" },
      "text-tertiary":     { "$value": "{neutral.500}" },
      "text-disabled":     { "$value": "{neutral.400}" },
      "text-inverse":      { "$value": "#FFFFFF" },
      "text-accent":       { "$value": "{indigo.700}" },
      "text-on-accent":    { "$value": "#FFFFFF" },
      "border-subtle":     { "$value": "{neutral.100}" },
      "border-default":    { "$value": "{neutral.300}" },
      "border-strong":     { "$value": "{neutral.200}" },
      "border-interactive":{ "$value": "{neutral.450}" },
      "border-focus":      { "$value": "{indigo.600}" },
      "action-primary-bg":        { "$value": "{indigo.600}" },
      "action-primary-bg-hover":  { "$value": "{indigo.700}" },
      "action-primary-bg-active": { "$value": "{indigo.800}" },
      "action-danger-bg":         { "$value": "{danger.600}" }
    },
    "dark": {
      "$type": "color",
      "bg-canvas":         { "$value": "{neutral.950}" },
      "bg-surface":        { "$value": "{neutral.900}" },
      "bg-surface-raised": { "$value": "{neutral.800}" },
      "bg-surface-sunken": { "$value": "#0A0C11" },
      "bg-accent-subtle":  { "$value": "{indigo.950}" },
      "text-primary":      { "$value": "{neutral.100}" },
      "text-secondary":    { "$value": "{neutral.400}" },
      "text-tertiary":     { "$value": "{neutral.500}" },
      "text-disabled":     { "$value": "{neutral.600}" },
      "text-inverse":      { "$value": "{neutral.950}" },
      "text-accent":       { "$value": "{indigo.300}", "$description": "indigo.600 hanya mencapai 1,9:1 di atas surface gelap — tidak dapat dipakai." },
      "text-on-accent":    { "$value": "#FFFFFF" },
      "border-subtle":     { "$value": "{neutral.800}" },
      "border-default":    { "$value": "{neutral.700}" },
      "border-strong":     { "$value": "{neutral.600}" },
      "border-interactive":{ "$value": "{neutral.500}" },
      "border-focus":      { "$value": "{indigo.400}" },
      "action-primary-bg":        { "$value": "{indigo.500}" },
      "action-primary-bg-hover":  { "$value": "{indigo.400}", "$description": "Arah hover berbalik di dark mode — menerangkan, bukan menggelapkan." },
      "action-primary-bg-active": { "$value": "{indigo.300}" },
      "action-danger-bg":         { "$value": "{danger.400}" }
    }
  }
}
