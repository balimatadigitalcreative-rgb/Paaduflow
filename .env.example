# Salin menjadi .env lalu sesuaikan. Jangan commit .env.
# Hanya tiga variabel ini yang benar-benar dipakai kode saat ini.

# Basis data untuk menjalankan aplikasi dan `npm run migrate`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paadu_dev

# Basis data untuk test invarian dan integrasi.
# Bila dikosongkan, PostgreSQL sementara dinyalakan otomatis — tanpa Docker.
TEST_DATABASE_URL=

# Port server HTTP lokal
PORT=3000
