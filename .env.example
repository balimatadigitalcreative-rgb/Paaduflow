# Salin menjadi .env lalu sesuaikan. Jangan commit .env.
#
# Setiap rahasia di bawah punya FORMAT yang dituntut kode, bukan sekadar nama.
# Perintah pembuatnya dicantumkan supaya tidak mungkin salah format — kunci
# hex yang tampak benar akan lolos disalin dan baru gagal saat proses menyala.
#
# Yang salah format ditolak `npm start` sebelum ia menyentuh basis data, dengan
# pesan yang menyebutkan format yang benar beserta perintah pembuatnya.


# ── Basis data ─────────────────────────────────────────────────────────────

# Kredensial RUNTIME. Di produksi ini paadu_app: tunduk RLS, bukan pemilik
# objek, dan tidak dapat mengubah skema.
#
# Format: URL koneksi PostgreSQL — postgresql://pengguna:sandi@host:port/basis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paadu_dev

# Kredensial MIGRASI — paadu_owner, pemilik objek.
#
# JANGAN letakkan ini di .env yang dimuat proses runtime. Ia dipakai `npm run
# migrate` saja, dan sebaiknya diberikan hanya saat perintah itu dijalankan:
#
#     MIGRATION_DATABASE_URL=postgresql://paadu_owner:...@host:5432/paadu npm run migrate
#
# Di server, `npm run deploy` membacanya dari /home/paadu/.env.deploy — berkas
# TERSENDIRI di luar direktori aplikasi, justru supaya ia tidak ikut termuat ke
# proses runtime (D-141).
#
# Bila kosong, `npm run migrate` jatuh ke DATABASE_URL dan mencetak peringatan.
# Itu cukup untuk lokal, ketika pemilik basis datanya memang superuser.
#
# Perannya sengaja BUKAN superuser dan TANPA BYPASSRLS. Superuser melewati Row
# Level Security sepenuhnya, sehingga kebijakan yang salah baru ketahuan saat
# deploy — persis yang terjadi pada D-141.
#
# Format: sama dengan DATABASE_URL
MIGRATION_DATABASE_URL=


# ── Rahasia ────────────────────────────────────────────────────────────────

# Penanda tangan JWT access token dan tantangan MFA (HS256).
#
# Format : teks bebas, MINIMAL 32 KARAKTER
#          Dipakai apa adanya sebagai bait UTF-8 — bukan base64, bukan hex.
#          Panjang di bawah 32 ditolak `JwtAccessTokenIssuer` saat menyala.
# Buat   : openssl rand -base64 48
#
# Mengganti nilainya mencabut SELURUH access token yang sedang berjalan.
TOKEN_SIGNING_SECRET=

# Kunci enkripsi rahasia MFA (AES-256-GCM).
#
# Format : BASE64 yang mendekode menjadi TEPAT 32 BYTE
#          Bukan hex. Hex 32 karakter mendekode menjadi 24 byte dan ditolak;
#          hex 64 karakter mendekode menjadi 48 byte dan juga ditolak.
#          Base64 yang benar panjangnya 44 karakter dan berakhir dengan '='.
# Buat   : openssl rand -base64 32
#
# Mengganti nilainya membuat rahasia MFA yang sudah tersimpan tidak dapat
# didekripsi lagi — seluruh pengguna harus mendaftarkan ulang perangkatnya.
MFA_ENCRYPTION_KEY=


# ── Server ─────────────────────────────────────────────────────────────────

# Port server HTTP.
#
# Format: bilangan bulat 1–65535
PORT=3000


# ── Test ───────────────────────────────────────────────────────────────────

# Basis data untuk test invarian dan integrasi.
# Bila dikosongkan, PostgreSQL sementara dinyalakan otomatis — tanpa Docker.
#
# Format: sama dengan DATABASE_URL, atau kosong
TEST_DATABASE_URL=
