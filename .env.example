# Salin menjadi .env lalu sesuaikan. Jangan commit .env.
# Hanya tiga variabel ini yang benar-benar dipakai kode saat ini.

# Basis data untuk menjalankan aplikasi — kredensial RUNTIME.
# Di produksi ini adalah paadu_app: tunduk RLS, bukan pemilik objek, dan tidak
# dapat mengubah skema.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paadu_dev

# Kredensial MIGRASI — paadu_owner, pemilik objek.
#
# JANGAN letakkan ini di .env yang dimuat proses runtime. Ia dipakai `npm run
# migrate` saja, dan sebaiknya diberikan hanya saat perintah itu dijalankan:
#
#   MIGRATION_DATABASE_URL=postgresql://paadu_owner:...@host:5432/paadu npm run migrate
#
# Bila kosong, `npm run migrate` jatuh ke DATABASE_URL dan mencetak peringatan.
# Itu cukup untuk lokal, ketika pemilik basis datanya memang superuser.
#
# Perannya sengaja BUKAN superuser dan TANPA BYPASSRLS. Superuser melewati Row
# Level Security sepenuhnya, sehingga kebijakan yang salah baru ketahuan saat
# deploy — persis yang terjadi pada D-141.
MIGRATION_DATABASE_URL=

# Basis data untuk test invarian dan integrasi.
# Bila dikosongkan, PostgreSQL sementara dinyalakan otomatis — tanpa Docker.
TEST_DATABASE_URL=

# Port server HTTP lokal
PORT=3000
