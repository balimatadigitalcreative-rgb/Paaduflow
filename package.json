{
  "name": "paadu-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Business Operating System multi-tenant untuk individu, UMKM, hingga enterprise Indonesia",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node tools/git-hooks/install.js",
    "tokens:build": "node tools/style-dictionary/build.js",
    "migrate": "node tools/db/migrate.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --allow-empty-input --fix",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run tokens:build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.17.0",
    "style-dictionary": "^5.5.1",
    "stylelint": "^17.14.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.11.3",
    "jose": "^6.2.8",
    "node-pg-migrate": "^9.0.0",
    "otpauth": "^9.5.1",
    "pg": "^8.23.0"
  }
}
