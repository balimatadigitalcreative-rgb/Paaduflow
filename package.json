{
  "name": "paadu-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Business Operating System multi-tenant untuk individu, UMKM, hingga enterprise Indonesia",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node tools/git-hooks/install.js",
    "tokens:build": "node tools/style-dictionary/build.js",
    "migrate": "node tools/db/migrate.js",
    "migrate:manual": "node tools/db/migrate-manual.js",
    "check:migrations": "node tools/db/check-migrations.js",
    "check:append-only": "node tools/db/check-append-only.js",
    "seed:tax-dev": "node tools/seed/pajak-pengembangan.js",
    "check:contrast": "node tools/a11y/contrast.js",
    "lint": "npm run lint:js && npm run lint:css && npm run check:append-only && npm run check:env && npm run audit:kontras && npm run check:i18n",
    "audit:kontras": "node tools/audit/kontras.js",
    "check:i18n": "node tools/i18n/periksa.js",
    "check:env": "node tools/check-env-example.js",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --allow-empty-input --fix",
    "predev": "npm run tokens:build",
    "dev": "node tools/dev/start.js",
    "predev:web": "npm run tokens:build",
    "dev:web": "vite",
    "seed:dev": "node tools/seed/pengembangan.js",
    "seed:demo": "node tools/seed/demo.js",
    "build": "npm run build:web && npm run build:server",
    "prebuild:web": "npm run tokens:build",
    "build:web": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node dist/server/main.js",
    "deploy": "node tools/deploy/deploy.js",
    "ship": "node tools/deploy/ship.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run tokens:build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.17.0",
    "jsdom": "^30.0.1",
    "style-dictionary": "^5.5.1",
    "stylelint": "^17.14.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@sinclair/typebox": "^0.34.52",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "fastify": "^5.11.3",
    "i18next": "^26.4.0",
    "jose": "^6.2.8",
    "node-pg-migrate": "^9.0.0",
    "otpauth": "^9.5.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12"
  }
}
